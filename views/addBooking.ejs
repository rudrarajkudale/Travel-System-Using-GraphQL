<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Travel Booking</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap');

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background: url('travel.jpg') no-repeat center center/cover;
        }

        .container {
            background: rgba(0, 0, 0, 0.6);
            padding: 50px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            text-align: center;
            width: 100%;
            max-width: 500px;
            backdrop-filter: blur(10px);
            color: white;
        }

        .alert {
            background-color: #28a745;
            color: white;
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 15px;
            display: none;
            animation: fadeIn 0.5s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            font-size: 26px;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .form-group {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 15px;
        }

        .form-group div {
            width: 50%;
        }

        label {
            font-weight: 600;
            display: block;
            text-align: left;
            margin-bottom: 6px;
            color: #ddd;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            border-radius: 8px;
            font-size: 16px;
            background: rgba(255, 255, 255, 0.1);
            color: white;
            transition: 0.3s;
        }

        input:focus, select:focus {
            border-color: #ff7e67;
            background: rgba(255, 255, 255, 0.2);
            outline: none;
            box-shadow: 0 0 10px rgba(255, 126, 103, 0.5);
        }

        button {
            background: #ff7e67;
            color: white;
            font-size: 16px;
            font-weight: 600;
            padding: 14px;
            border: none;
            border-radius: 8px;
            width: 100%;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }

        button:hover {
            background: #e65b48;
            box-shadow: 0 4px 15px rgba(230, 91, 72, 0.3);
        }

    </style>
</head>
<body>
    <div class="container">
        <% if (message) { %>
            <div class="alert" id="successAlert">
                <strong>Success!</strong> <%= message %>
            </div>
            <script>
                document.getElementById("successAlert").style.display = "block";
                setTimeout(() => {
                    document.getElementById("successAlert").style.display = "none";
                }, 3000);
            </script>
        <% } %>
        
        <h2>Book Your Travel Ticket</h2>
        <form action="/add-booking" method="POST">
            <div class="form-group">
                <div>
                    <label for="name">Name</label>
                    <input type="text" name="name" required>
                </div>
                <div>
                    <label for="price">Price</label>
                    <input type="number" name="price" required>
                </div>
            </div>

            <div class="form-group">
                <div>
                    <label for="from">From</label>
                    <input type="text" name="from" required>
                </div>
                <div>
                    <label for="destination">Destination</label>
                    <input type="text" name="destination" required>
                </div>
            </div>

            <div class="form-group">
                <div>
                    <label for="date">Date</label>
                    <input type="date" name="date" required>
                </div>
                <div>
                    <label for="time">Time</label>
                    <input type="time" name="time" required>
                </div>
            </div>

            <label for="transportMode">Transport Mode</label>
            <select name="transportMode" required>
                <option value="Plane">Plane</option>
                <option value="Train">Train</option>
                <option value="Bus">Bus</option>
            </select>

            <button type="submit">Book Ticket</button>
        </form>
    </div>
</body>
</html>
